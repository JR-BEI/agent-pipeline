{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/pipeline.schema.json",
  "title": "Pipeline kit configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "owned_paths",
    "commands",
    "deploy",
    "database",
    "ui_library",
    "models",
    "budget",
    "runner",
    "allowed_paths_default"
  ],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "owned_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "default": [
        ".github/workflows/ci.yml",
        ".github/workflows/review.yml",
        ".github/workflows/migrate.yml",
        ".github/ISSUE_TEMPLATE/ticket.yml",
        "AGENTS.md",
        "CLAUDE.md",
        ".claude/settings.json",
        "scripts/lane/",
        "scripts/agent/"
      ]
    },
    "keep_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "dev", "test", "lint", "typecheck", "migrate", "snapshot"],
      "properties": {
        "install": { "type": "string" },
        "dev": { "type": "string" },
        "test": { "type": "string" },
        "lint": { "type": "string" },
        "typecheck": { "type": "string" },
        "migrate": { "type": "string" },
        "snapshot": { "type": "string" }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "production_branch"],
      "properties": {
        "provider": { "enum": ["vercel", "none"], "default": "none" },
        "production_branch": { "type": "string", "minLength": 1, "default": "main" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "lane_setup"],
      "properties": {
        "provider": { "enum": ["supabase", "postgres", "none"], "default": "none" },
        "lane_setup": { "type": "string" }
      }
    },
    "supabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_ref"],
      "properties": {
        "project_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+$",
          "errorMessage": { "pattern": "must be a Supabase project ref (lowercase letters and digits)" }
        }
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep": { "type": "integer", "minimum": 1, "default": 3 },
        "part_mb": { "type": "integer", "minimum": 1, "maximum": 45, "default": 45 }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "real_data_diff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "command"],
          "$comment": "Base-vs-head diff the runner runs when a changed file matches a glob in paths.",
          "errorMessage": {
            "required": {
              "paths": "is required; list the repository-relative globs whose changes trigger the diff",
              "command": "is required when paths are set; give the command the runner runs once on base and once on head"
            }
          },
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "$comment": "Globs: ** crosses directories, * and ? stay inside one segment.",
              "items": {
                "type": "string",
                "pattern": "^(?![/\\\\])(?!(?:.*/)?\\.\\.(?:/|$))\\S(?:.*\\S)?$",
                "errorMessage": { "pattern": "must be a repository-relative glob (no leading slash, no .. segment, no surrounding whitespace)" }
              }
            },
            "command": {
              "type": "string",
              "pattern": "\\S",
              "errorMessage": { "pattern": "must be a non-empty command" }
            }
          }
        }
      }
    },
    "ui_library": { "type": ["string", "null"] },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tiers", "reviewer", "review_location", "escalations_per_ticket"],
      "properties": {
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "standard", "hard"],
          "properties": {
            "light": { "type": "string" },
            "standard": { "type": "string" },
            "hard": { "type": "string" }
          }
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "$comment": "Maps each builder model ID to a different reviewer model ID."
        },
        "review_location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openai", "anthropic"],
          "properties": {
            "openai": { "enum": ["mac", "ci"] },
            "anthropic": { "enum": ["mac", "ci"] }
          }
        },
        "escalations_per_ticket": { "type": "integer", "minimum": 0, "default": 1 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_usd", "max_review_rounds"],
      "properties": {
        "default_usd": { "type": "number", "minimum": 0 },
        "max_review_rounds": { "type": "integer", "minimum": 0, "default": 3 },
        "wall_clock_minutes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "standard", "hard"],
          "properties": {
            "light": { "type": "integer", "minimum": 1 },
            "standard": { "type": "integer", "minimum": 1 },
            "hard": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_name", "git_email"],
      "$comment": "Identity for every lane commit. Vercel verifies the email against a GitHub account, so use its noreply address.",
      "properties": {
        "git_name": { "type": "string", "minLength": 1 },
        "git_email": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "errorMessage": { "pattern": "must be an email address; use the GitHub account noreply address from GitHub Settings > Emails" }
        }
      }
    },
    "allowed_paths_default": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
