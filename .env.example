# Fake examples. The CLI does not load this file. Export what you need in your shell.

# Needed by `pipeline check` when the target has no GitHub origin remote.
GITHUB_REPOSITORY=example-org/example-app

# Optional path to the GitHub CLI. Defaults to gh on your PATH.
PIPELINE_GH=gh

# Optional. Only if you do not use `gh auth login`.
# GH_TOKEN=replace-me
